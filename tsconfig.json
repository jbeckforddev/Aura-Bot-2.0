{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "noEmitOnError": true,
    "incremental": true,
    "tsBuildInfoFile": "./cache/.tsbuildinfo",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": [
    "main.ts",
    "handler.ts",
    "config.ts",
    "cmd/**/*.ts",
    "core/**/*.ts",
    "connection/**/*.ts",
    "database/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".git",
    "cache",
    "data",
    "assets",
    "cmd/group/Crashx.ts",
    "cmd/system/Crashmap.ts",
    "cmd/system/Crashv3.ts",
    "cmd/system/Crashv4.ts",
    "cmd/system/crash.ts",
    "cmd/system/popupv2.ts",
    "cmd/system/Testxd3.ts",
    "cmd/system/Voip.ts",
    "cmd/system/crack.ts",
    "cmd/system/spam.ts",
    "cmd/system/whoisp.ts",
    "cmd/system/wip.ts",
    "core/ipTrap.ts",
    "patches",
    "tests",
    "src/libs/**"
  ]
}
